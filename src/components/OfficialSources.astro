---
type Source = {
  title: string;
  url: string;
  type?: string;
};

const { sources = [] } = Astro.props as { sources?: Source[] };
const isServicePortal = (url: string) => {
  const pathname = new URL(url).pathname.replace(/\/+$/, '');
  return pathname === '' || /\/(?:main|index)\.(?:do|html?|pt)$/i.test(pathname) || /^\/(?:en|eng|english)$/i.test(pathname);
};
---
{sources.length > 0 && (
  <section class="official-sources" id="official-sources">
    <h2>Official Sources to Verify</h2>
    <p>Check the tax year, eligibility conditions, and publication date in the official material before applying a rule. A link marked “Service portal” helps you find a service; it does not substantiate a particular rate or entitlement.</p>
    <ul>
      {sources.map((source) => (
        <li>
          <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
          {isServicePortal(source.url) && <span class="meta"> — Service portal</span>}
        </li>
      ))}
    </ul>
  </section>
)}

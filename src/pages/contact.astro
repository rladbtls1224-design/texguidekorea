---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://taxguidekorea.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://taxguidekorea.com/contact/' }
  ]
};
---
<BaseLayout title="Contact" description="Contact Korea Tax Guide for Foreigners with corrections, official source suggestions, privacy questions, or partnership inquiries." canonical="/contact/" jsonLd={jsonLd}>
  <main class="section narrow article">
    <Breadcrumbs items={[{ label: 'Contact' }]} />
    <h1>Contact</h1>
    <p>For corrections, official source suggestions, privacy questions, or partnership inquiries, email <a href="mailto:rladbtls1224@gmail.com">rladbtls1224@gmail.com</a>.</p>
    <p>This inbox is for questions about this publication. It does not provide a tax filing service or personal case review.</p>
    <h2>Correction requests</h2>
    <p>If you believe a page contains an error or outdated statement, include the page URL, the sentence or section involved, and the official source that supports the correction.</p>
    <ul>
      <li>Page URL and the heading or sentence concerned</li>
      <li>The tax year or effective date involved, if relevant</li>
      <li>A link to the official notice, publication, law, or service instructions</li>
    </ul>
    <h2>Source suggestions</h2>
    <p>We prefer official and stable sources such as the National Tax Service, Hometax, Hi Korea, Government24, Korean Law Information Center, and Wetax. Please do not send personal blogs or forum posts as primary sources for tax rules.</p>
    <h2>No personal case review</h2>
    <p>Please do not send personal tax records, identification documents, visa documents, financial records, or urgent legal questions. This website does not provide personal tax, legal, immigration, or refund advice.</p>
    <p>For questions about information sent to this inbox, read our <a href="/privacy/">Privacy Policy</a> and use the same email address. You can describe a correction without attaching private records.</p>
  </main>
</BaseLayout>
